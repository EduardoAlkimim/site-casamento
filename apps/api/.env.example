# Copie para .env (nunca versionar o .env real)
PORT=3001
HOST=127.0.0.1
DB_PATH=data/casamento.db
# Texto aleatório longo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=
# Gerado por: npm run hash-password -w apps/api -- "sua senha"
ADMIN_PASSWORD_HASH=
# Endereço do site na Vercel (para montar os links das tags NFC)
PUBLIC_SITE_URL=http://localhost:5173
