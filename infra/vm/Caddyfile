# O site vem pela Vercel, que informa o endereço real do convidado no
# X-Forwarded-For. Confiamos nesse cabeçalho para a API enxergar cada pessoa
# separadamente (limites por pessoa). Como ele pode ser forjado por quem chama
# a VM direto, o login do painel usa um limite global, não por endereço.
{
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

# Só a API fica aqui; o site é servido pela Vercel, que repassa /api/* para cá.
__SITE_HOST__ {
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		respond "Eduardo & Thamires · API" 404
	}
}
